# Normalise text to LF in the repository; Git restores native endings on
# checkout. Without this, committing from Windows stores CRLF and every file
# shows as fully rewritten in later diffs.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.pdf binary

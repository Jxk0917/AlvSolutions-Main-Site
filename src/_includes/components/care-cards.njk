{#
  The two monthly plans. Deliberately a different card shape from the build
  tiers: a care plan is a recurring charge on a different clock, and making it
  look like a fourth package would invite people to read it as an alternative
  to one rather than a requirement alongside one.
#}
<div class="cares">
  {%- for p in careplans.plans %}
  <article class="care{% if p.recommended %} pop{% endif %} reveal" style="--d:{{ loop.index0 }}">
    <div class="care-top">
      <h3 class="care-name">{{ p.name }}</h3>
      <span class="care-price">
        {{ p.price | price | safe }}<span class="care-per">/mo</span>
      </span>
    </div>
    <p class="care-for">{{ p.for }}</p>

    {%- if p.builds %}
    <p class="tier-builds">Everything in {{ p.builds }}, plus:</p>
    {%- endif %}

    <ul class="tier-list">
      {%- for i in p.includes %}
      <li>
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
        <span>{{ i }}</span>
      </li>
      {%- endfor %}
    </ul>
  </article>
  {%- endfor %}
</div>

<p class="care-note reveal">
  <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-clock"/></svg>
  <span>{{ careplans.minimum }}</span>
</p>

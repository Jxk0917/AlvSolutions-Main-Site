{#
  The whole contact block — copy, the three "what happens next" items, and the
  project intake wizard. Rendered on the home page and on /contact/ from this
  one file, so the two can never drift.

  The form is a four-panel wizard: three answer steps and a review. Every panel
  ships in the markup; `hidden` on all but the first is the only thing that
  makes it a wizard, so with JS off the first step still renders and reads.

  The form submits asynchronously to Formspree (fetch + FormData) from the
  submit handler at the bottom of assets/main.js, which stays on this page
  and shows the .sent panel below on success. `data-endpoint` is the only
  place the Formspree URL lives; the destination inbox itself is configured
  on the Formspree form, not here.
#}
<section class="sec" id="contact">
  <div class="wrap contact">

    <div class="reveal">
      <h2>{{ contactHeading | default("Let's talk about your site.") }}</h2>
      <p class="lead" style="margin-top: 18px;">
        {{ contactLead | default("Tell me what your business does and what you need. Free quote, no pressure.") }}
      </p>

      <div class="next">
        <div class="next-item">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-mail"/></svg>
          <div>
            <h3>I reply within a day</h3>
            <p>Usually the same afternoon.</p>
          </div>
        </div>
        <div class="next-item">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-message"/></svg>
          <div>
            <h3>A short call</h3>
            <p>Fifteen minutes to understand the business and what the site has to do.</p>
          </div>
        </div>
        <div class="next-item">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-shield-check"/></svg>
          <div>
            <h3>A flat quote and a date</h3>
            <p>One price and a launch day, both agreed before any work starts.</p>
          </div>
        </div>
      </div>
    </div>

    <form class="form reveal" id="quote-form" novalidate style="--d:1" data-endpoint="https://formspree.io/f/mkjgnlve">

      {#- Position, then the bar. The step names live on the panels themselves
          (data-step-label) so the copy sits with the step it belongs to and the
          bar has nothing to keep in sync by hand. -#}
      <div class="wiz-head">
        <div class="wiz-meta">
          <span class="wiz-count">Step <span data-step-n>1</span> of 4</span>
          <span class="wiz-now" data-step-name>Contact</span>
        </div>
        <div class="wiz-bar" role="progressbar" aria-label="How far through the form you are"
             aria-valuemin="1" aria-valuemax="4" aria-valuenow="1" aria-valuetext="Step 1 of 4, Contact">
          <span class="wiz-fill" data-fill></span>
        </div>
        <p class="vh" role="status" aria-live="polite" data-live></p>
      </div>

      <div class="form-body">

        {#- The package cards link to /contact/?package=growth. The tier rides
            along in this field so the first reply can be a quote rather than a
            question they already answered by clicking. -#}
        <input type="hidden" name="package" value="" />
        <p class="pill wiz-tag" hidden>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-tag"/></svg>
          <span data-package-label></span>
        </p>

        <!-- ══════════════ 1. CONTACT ══════════════ -->
        <section class="wiz-panel" data-panel data-step-label="Contact" role="group" aria-labelledby="wiz-h1">
          <h3 class="wiz-title" id="wiz-h1" tabindex="-1">Your contact details</h3>
          <p class="wiz-sub">So I know who I am quoting and where to reach you.</p>

          <p class="wiz-alert" data-alert role="alert" hidden>
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>
            <span data-alert-text></span>
          </p>

          <div class="field-row">
            <div class="field" data-field data-req>
              <label for="f-name">Full name</label>
              <input class="input" id="f-name" name="name" type="text" autocomplete="name"
                     aria-describedby="e-name" placeholder="Jordan Alvarez" />
              <span class="err" id="e-name"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Enter your full name</span>
            </div>
            <div class="field" data-field data-req>
              <label for="f-business">Business name</label>
              <input class="input" id="f-business" name="business" type="text" autocomplete="organization"
                     aria-describedby="e-business" placeholder="Alvarez Roofing" />
              <span class="err" id="e-business"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Enter your business name</span>
            </div>
          </div>

          <div class="field-row">
            <div class="field" data-field data-req>
              <label for="f-email">Email</label>
              <input class="input" id="f-email" name="email" type="email" autocomplete="email"
                     data-check="email" aria-describedby="e-email" placeholder="you@yourbusiness.com" />
              <span class="err" id="e-email"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Enter an email address, like you@yourbusiness.com</span>
            </div>
            <div class="field" data-field data-req>
              <label for="f-phone">Phone</label>
              <input class="input" id="f-phone" name="phone" type="tel" autocomplete="tel"
                     data-check="phone" aria-describedby="e-phone" placeholder="(210) 555 0134" />
              <span class="err" id="e-phone"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Enter a phone number with its area code</span>
            </div>
          </div>

          <div class="field" data-field data-req>
            <label for="f-city">City or service area</label>
            <span class="hint" id="h-city">Where your customers are, not necessarily where you are.</span>
            <input class="input" id="f-city" name="city" type="text" autocomplete="address-level2"
                   aria-describedby="h-city e-city" placeholder="San Antonio and surrounding areas" />
            <span class="err" id="e-city"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Tell me the city or area you serve</span>
          </div>

          <fieldset class="fset" data-field data-req data-group>
            <legend class="fset-lg">Do you have a website now?</legend>
            <div class="seg">
              <label class="opt opt-one">
                <input type="radio" name="hasSite" value="Yes" data-cond="c-url" />
                <span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">Yes</span></span>
              </label>
              <label class="opt opt-one">
                <input type="radio" name="hasSite" value="No" />
                <span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">No</span></span>
              </label>
            </div>
            <span class="err"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Choose yes or no</span>
          </fieldset>

          <div class="field cond" id="c-url" data-field data-req hidden>
            <label for="f-url">What is the address?</label>
            <input class="input" id="f-url" name="siteUrl" type="text" autocomplete="url" inputmode="url"
                   data-check="url" aria-describedby="e-url" placeholder="alvarezroofing.com" />
            <span class="err" id="e-url"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Enter the web address, like alvarezroofing.com</span>
          </div>
        </section>

        <!-- ══════════════ 2. BUSINESS ══════════════ -->
        <section class="wiz-panel" data-panel data-step-label="Business" role="group" aria-labelledby="wiz-h2" hidden>
          <h3 class="wiz-title" id="wiz-h2" tabindex="-1">About the business</h3>
          <p class="wiz-sub">This sets which examples and which layout I start from.</p>

          <p class="wiz-alert" data-alert role="alert" hidden>
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>
            <span data-alert-text></span>
          </p>

          <div class="field" data-field data-req>
            <label for="f-type">Business type</label>
            <div class="sel">
              <select class="input" id="f-type" name="businessType" required
                      data-cond="c-type" data-cond-value="Other" aria-describedby="e-type">
                <option value="" selected disabled>Choose one</option>
                <option>Auto detailing</option>
                <option>Home services</option>
                <option>Restaurant / food</option>
                <option>Salon / barber / beauty</option>
                <option>Professional services</option>
                <option>Retail</option>
                <option>Other</option>
              </select>
              <svg class="ic sel-chev" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-chevron-down"/></svg>
            </div>
            <span class="err" id="e-type"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Pick the closest match</span>
          </div>

          <div class="field cond" id="c-type" data-field data-req hidden>
            <label for="f-type-other">What does the business do?</label>
            <span class="hint" id="h-type-other">A sentence is plenty.</span>
            <textarea class="input input-sm" id="f-type-other" name="businessOther" rows="3" maxlength="400"
                      aria-describedby="h-type-other e-type-other"
                      placeholder="We install and service commercial ice machines for restaurants."></textarea>
            <span class="err" id="e-type-other"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Tell me what the business does</span>
          </div>
        </section>

        <!-- ══════════════ 3. GOALS ══════════════ -->
        <section class="wiz-panel" data-panel data-step-label="Goals" role="group" aria-labelledby="wiz-h3" hidden>
          <h3 class="wiz-title" id="wiz-h3" tabindex="-1">What the site has to do</h3>
          <p class="wiz-sub">These answers decide the pages, the buttons and the price.</p>

          <p class="wiz-alert" data-alert role="alert" hidden>
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>
            <span data-alert-text></span>
          </p>

          <fieldset class="fset" data-field data-req data-group>
            <legend class="fset-lg">What do you want your website to help customers do?</legend>
            <span class="hint">Pick as many as apply.</span>
            <div class="opt-pair">
              <label class="opt"><input type="checkbox" name="goals" value="Call the business" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">Call the business</span></span></label>
              <label class="opt"><input type="checkbox" name="goals" value="Request a quote" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">Request a quote</span></span></label>
              <label class="opt"><input type="checkbox" name="goals" value="Book an appointment" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">Book an appointment</span></span></label>
              <label class="opt"><input type="checkbox" name="goals" value="View services" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">View services</span></span></label>
              <label class="opt"><input type="checkbox" name="goals" value="View a menu" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">View a menu</span></span></label>
              <label class="opt"><input type="checkbox" name="goals" value="Access delivery / ordering" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">Access delivery / ordering</span></span></label>
              <label class="opt"><input type="checkbox" name="goals" value="View work / portfolio" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">View work / portfolio</span></span></label>
              <label class="opt"><input type="checkbox" name="goals" value="Find the business location" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">Find the business location</span></span></label>
              <label class="opt"><input type="checkbox" name="goals" value="Learn about the business" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">Learn about the business</span></span></label>
              <label class="opt"><input type="checkbox" name="goals" value="Contact the business" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">Contact the business</span></span></label>
              <label class="opt"><input type="checkbox" name="goals" value="Other" data-cond="c-goal" /><span class="opt-face"><span class="opt-mark"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg></span><span class="opt-txt">Other</span></span></label>
            </div>
            <span class="err"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Pick at least one thing the site should do</span>
          </fieldset>

          <div class="field cond" id="c-goal" data-field data-req hidden>
            <label for="f-goal-other">What else should it do?</label>
            <input class="input" id="f-goal-other" name="goalOther" type="text" maxlength="200"
                   aria-describedby="e-goal-other" placeholder="Let customers upload photos before a quote" />
            <span class="err" id="e-goal-other"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Tell me what else the site should do</span>
          </div>

          <fieldset class="fset" data-field data-req data-group>
            <legend class="fset-lg">Budget</legend>
            <span class="hint">A range is enough. It steers the scope, it is not a commitment.</span>
            <div class="opt-grid">
              <label class="opt opt-one"><input type="radio" name="budget" value="Under $650" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">Under $650</span></span></label>
              <label class="opt opt-one"><input type="radio" name="budget" value="$650 - $1,000" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">$650 - $1,000</span></span></label>
              <label class="opt opt-one"><input type="radio" name="budget" value="$1,000 - $1,500" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">$1,000 - $1,500</span></span></label>
              <label class="opt opt-one"><input type="radio" name="budget" value="$1,500 - $2,500" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">$1,500 - $2,500</span></span></label>
              <label class="opt opt-one"><input type="radio" name="budget" value="$2,500+" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">$2,500+</span></span></label>
              <label class="opt opt-one"><input type="radio" name="budget" value="Not sure yet" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">Not sure yet</span></span></label>
            </div>
            <span class="err"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Pick a budget range</span>
          </fieldset>

          <fieldset class="fset" data-field data-req data-group>
            <legend class="fset-lg">Timeline</legend>
            <div class="opt-stack">
              <label class="opt opt-one"><input type="radio" name="timeline" value="As soon as possible" data-cond="c-rush" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">As soon as possible</span></span></label>
              <label class="opt opt-one"><input type="radio" name="timeline" value="Within 2 weeks" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">Within 2 weeks</span></span></label>
              <label class="opt opt-one"><input type="radio" name="timeline" value="Within a month" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">Within a month</span></span></label>
              <label class="opt opt-one"><input type="radio" name="timeline" value="1 - 3 months" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">1 - 3 months</span></span></label>
              <label class="opt opt-one"><input type="radio" name="timeline" value="No hard deadline" /><span class="opt-face"><span class="opt-mark"></span><span class="opt-txt">No hard deadline</span></span></label>
            </div>
            <span class="err"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>Pick a timeline</span>
            <p class="wiz-note cond" id="c-rush" role="status" hidden>
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-clock"/></svg>
              <span>Rush delivery may cost extra, depending on what is already booked. I confirm the figure with you before any work starts.</span>
            </p>
          </fieldset>
        </section>

        <!-- ══════════════ 4. REVIEW ══════════════ -->
        <section class="wiz-panel" data-panel data-step-label="Review" role="group" aria-labelledby="wiz-h4" hidden>
          <h3 class="wiz-title" id="wiz-h4" tabindex="-1">Review your request</h3>
          <p class="wiz-sub">This is exactly what reaches me. Change anything that is not right.</p>

          <div class="rev">
            <div class="rev-group">
              <div class="rev-head">
                <h4>Contact</h4>
                <button class="rev-edit" type="button" data-edit="0">Edit<span class="vh"> your contact details</span></button>
              </div>
              <dl class="rev-list" data-rev="contact"></dl>
            </div>
            <div class="rev-group">
              <div class="rev-head">
                <h4>Business</h4>
                <button class="rev-edit" type="button" data-edit="1">Edit<span class="vh"> your business details</span></button>
              </div>
              <dl class="rev-list" data-rev="business"></dl>
            </div>
            <div class="rev-group">
              <div class="rev-head">
                <h4>Goals, budget and timing</h4>
                <button class="rev-edit" type="button" data-edit="2">Edit<span class="vh"> your goals, budget and timing</span></button>
              </div>
              <dl class="rev-list" data-rev="goals"></dl>
            </div>
          </div>

          <div class="field" data-field>
            <label for="f-notes">Anything else I should know? <span class="opt-tag">Optional</span></label>
            <textarea class="input" id="f-notes" name="notes" rows="3" maxlength="1200"
                      placeholder="A site you like the look of, a date that is fixed, anything that has gone wrong before."></textarea>
          </div>

          <p class="wiz-alert" data-submit-error role="alert" hidden>
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-alert"/></svg>
            <span>
              <span data-submit-error-text>Something went wrong sending your request.</span>
              Nothing here was lost &mdash; try again, or email me directly at
              <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
            </span>
          </p>
        </section>

        <div class="wiz-nav">
          <button class="btn btn-ghost wiz-back" type="button" data-back hidden>
            <svg class="ic wiz-back-ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
            Back
          </button>
          <button class="btn btn-primary" type="button" data-next>
            Continue
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
          </button>
          <button class="btn btn-primary" type="submit" data-send hidden>
            <span data-send-label>Send project details</span>
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
          </button>
        </div>

        <p class="form-note">
          Or email me directly at
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        </p>
      </div>

      <div class="sent" role="status" aria-live="polite">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-circle-check"/></svg>
        <h3 tabindex="-1" data-sent-head>Thanks<span data-firstname></span>. I have your project request.</h3>
        <p class="sent-lead">I will review everything and follow up within one business day with any questions and my recommended setup.</p>
        <p class="sent-note">
          Your project details have been sent. If you do not hear back within a day,
          email <a href="mailto:{{ site.email }}">{{ site.email }}</a> directly.
        </p>
      </div>
    </form>

  </div>
</section>

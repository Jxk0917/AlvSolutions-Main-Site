{#
  Site-wide footer (Phase 4B foundation): carries the fuller site structure
  the primary nav intentionally leaves out. Reuses the existing production
  data (site.footerGroups, site.legalLinks, site.tagline, site.email,
  site.city) rather than duplicating business information. Screen Light
  styling only.
#}
{% from "components/identity.njk" import lockup %}
<footer class="alv-foot">
  <div class="alv-wrap">
    <div class="alv-foot-grid">
      <div>
        <a class="alv-nav-mark" href="/" aria-label="{{ site.name }}, home">{{ lockup("nav") }}</a>
        <p style="margin-top: 12px; max-width: 32ch;">{{ site.tagline }}</p>
        <p style="margin-top: 12px;">
          <a class="alv-foot-contact" href="mailto:{{ site.email }}">{{ site.email }}</a><br />
          {{ site.city }}
        </p>
      </div>

      {%- for group in site.footerGroups %}
      <nav aria-label="{{ group.title }}">
        <p style="color: var(--sl-ink2); font-weight: 600; margin-bottom: 4px;">{{ group.title }}</p>
        {%- for link in group.links %}
        <a href="{{ link.url }}">{{ link.label }}</a>
        {%- endfor %}
      </nav>
      {%- endfor %}
    </div>

    <div class="alv-foot-small">
      <span>&copy; 2026 {{ site.name }}. All rights reserved.</span>
      <span>
        {%- for link in site.legalLinks %}
        <a href="{{ link.url }}">{{ link.label }}</a>{% if not loop.last %} · {% endif %}
        {%- endfor %}
      </span>
      <span>Built and supported in San Antonio.</span>
    </div>
  </div>
</footer>

{#
  Four columns: the brand block carries the contact details (they used to be a
  column of their own, which does not survive going from one link group to
  three), then Services, Pricing and Company from site.footerGroups.
#}
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">

      <div class="foot-brand">
        <a class="brand" href="/" style="margin-bottom: 16px;" aria-label="AlvSolutions home">
          <img src="/assets/brand/alv-mark.png" alt="" width="42" height="27" />
          <span class="wordmark">Alv<span>Solutions</span></span>
        </a>
        <p class="body-3" style="max-width: 32ch;">{{ site.tagline }}</p>

        <div class="foot-list" style="margin-top: 20px;">
          <a class="foot-contact" href="mailto:{{ site.email }}">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-mail"/></svg>
            {{ site.email }}
          </a>
          <span class="foot-contact">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-pin"/></svg>
            {{ site.city }}
          </span>
          <a class="btn btn-primary btn-sm" href="/contact/" style="margin-top: 8px; justify-self: start;">Start a project</a>
        </div>
      </div>

      {%- for group in site.footerGroups %}
      <div>
        <h4>{{ group.title }}</h4>
        <div class="foot-list">
          {%- for link in group.links %}
          <a href="{{ link.url }}">{{ link.label }}</a>
          {%- endfor %}
        </div>
      </div>
      {%- endfor %}

    </div>

    <div class="foot-bar">
      <span>&copy; 2026 AlvSolutions. All rights reserved.</span>
      <span class="foot-legal">
        {%- for link in site.legalLinks %}
        <a href="{{ link.url }}">{{ link.label }}</a>
        {%- endfor %}
      </span>
      <span>Built and supported in San Antonio.</span>
    </div>
  </div>
</footer>

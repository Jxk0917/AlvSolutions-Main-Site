{#
  Site-wide navigation: the logo (home), then the approved destinations as
  real routes (site.primaryNav: Packages, Services, What I Build, Pricing, About), then
  Start a project. The same on every page including
  Home. A page inside a section (a build, a service) keeps its section lit
  (aria-current="true"; the page itself is aria-current="page"). "Start a
  project" always goes to the /contact/ wizard.

  The mobile menu is a native <details>, so it opens and closes with no JS
  at all; site.ts only adds Escape-to-close with focus returned to "Menu".

  Screen Light styling only. No client colour ever reaches this identity.
#}
{% from "components/identity.njk" import lockup %}
<header class="alv-nav" data-nav>
  <div class="alv-wrap alv-nav-in">
    <a class="alv-nav-mark" href="/" aria-label="{{ site.name }}, home">
      {{ lockup("nav") }}
    </a>

    <nav class="alv-nav-links" aria-label="Primary">
      {%- for item in site.primaryNav %}
      <a class="alv-lit-sel" href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% elif page.url.startsWith(item.url) %} aria-current="true"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>

    <a class="alv-btn alv-btn--sm alv-nav-cta" href="/contact/">Start a project</a>

    <details class="alv-menu" data-menu>
      <summary class="alv-pill">Menu</summary>
      <div class="alv-menu-panel">
        <nav aria-label="Mobile">
          {%- for item in site.primaryNav %}
          <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% elif page.url.startsWith(item.url) %} aria-current="true"{% endif %}>{{ item.label }}</a>
          {%- endfor %}
        </nav>
        <a class="alv-btn" href="/contact/">Start a project</a>
        <p class="alv-menu-foot">{{ site.email }}</p>
      </div>
    </details>
  </div>
</header>

{#
  The three steps. Authoritative content lives in src/_data/process.json, so
  it exists in one place rather than being retyped per page.

  `processHeading` overrides the default, so the service pages can ask the
  question the reader has just formed instead of repeating the home heading.
#}
<section class="sec" id="process">
  <div class="wrap">
    <div class="sec-head reveal" style="margin-bottom: clamp(48px, 6vw, 68px);">
      <h2>{{ processHeading | default("How a project runs.") }}</h2>
    </div>

    <div class="steps">
      {%- for s in process.steps %}
      <div class="step reveal" style="--d:{{ loop.index0 }}">
        <span class="step-n">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{ s.icon }}"/></svg>
          0{{ loop.index }}
        </span>
        <h3>{{ s.clause }}</h3>
        <p>{{ s.detail }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

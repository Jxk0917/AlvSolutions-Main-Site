{#
  One service in a grid. Called with `card` — deliberately not `svc`: the
  service page sets `svc` for the page it is rendering, and a related-services
  loop that reassigned `svc` would clobber it for everything after the loop.

  The foot reads the service's own pricing block, so a card can never quote a
  figure the page it links to does not.
#}
{%- set p = card.pricing %}
<a class="card card-hover svc-card reveal" href="/services/{{ card.slug }}/" style="--d:{{ d | default(0) }}">
  <div class="ic-box">
    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{ card.icon }}"/></svg>
  </div>
  <h3>{{ card.name }}</h3>
  <p>{{ card.blurb }}</p>

  <span class="svc-foot">
    {%- if p.kind == "package" %}
    <span class="svc-from">From {{ packages.tiers[0].price | price | safe }}</span>
    {%- elif p.kind == "levels" %}
    <span class="svc-from">From {{ p.levels[0].price | price | safe }}</span>
    {%- elif p.kind == "care" %}
    <span class="svc-from">From {{ careplans.plans[0].price | price | safe }}/mo</span>
    {%- elif p.kind == "flat" %}
    <span class="svc-from">{% if p.from %}From {% endif %}{{ p.price | price | safe }}</span>
    {%- elif p.kind == "soon" %}
    <span class="svc-from svc-soon">Coming soon</span>
    {%- endif %}
    <svg class="ic svc-arrow" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
  </span>
</a>

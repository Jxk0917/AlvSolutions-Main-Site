{#
  The three build packages. Reads packages.tiers directly — the comparison
  chart below reads the same objects, so a card and its column can never
  disagree about what a tier includes.

  A card lists only what CHANGED from the tier it builds on, computed from the
  same `has` map rather than written out a second time. That is what makes
  "Everything in Foundation, plus:" true by construction instead of by hand.

  The price is one-time. The care plan is a separate, required monthly charge
  and is stated on every card, because a build price shown without it is a
  price that will surprise someone later.
#}
<div class="tiers">
  {%- for t in packages.tiers %}
  {%- set prev = packages.tiers | find("slug", t.builds) %}
  <article class="tier{% if t.recommended %} pop{% endif %} reveal" id="{{ t.slug }}" style="--d:{{ loop.index0 }}">
    {%- if t.recommended %}<span class="tier-badge">Recommended</span>{% endif %}

    <h3 class="tier-name">{{ t.name }}</h3>
    <p class="tier-for">{{ t.for }}</p>

    <div class="tier-price">
      <span class="tier-amt">{{ t.price | price | safe }}</span>
      <span class="tier-unit">one-time</span>
      <span class="tier-mo">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-refresh"/></svg>
        Plus a care plan from {{ careplans.plans[0].price | price | safe }}/mo, required
      </span>
    </div>

    {%- if prev %}
    <p class="tier-builds">Everything in {{ prev.name }}, plus:</p>
    {%- endif %}

    <ul class="tier-list">
      {%- for f in packages.features %}
      {%- set v = t.has[f.key] %}
      {#- only the delta: a row that reads the same as the tier below it is
          already covered by the "Everything in X" line above -#}
      {%- if v and (not prev or prev.has[f.key] !== v) %}
      <li>
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
        <span>
          {%- if v === true %}{{ f.label }}
          {%- else %}{{ f.label }} &middot; <b>{{ v }}</b>{% endif %}
        </span>
      </li>
      {%- endif %}
      {%- endfor %}
    </ul>

    {#- The picks are the part of this offer people misread, so they get shape
        rather than another bullet: one token per choice you actually make.
        A tier with no picks still shows the block, because "none included" is
        the answer to the same question and leaving it blank only makes the
        card look unfinished next to the two that have it. -#}
    {%- if not t.picks %}
    <div class="picks picks-none">
      <span class="picks-lg">Your picks, from the add-on list</span>
      <p class="picks-txt">None included. Any of the fifteen can still be added at its listed price.</p>
      <a class="picks-link" href="/packages/add-ons/">See what you can add</a>
    </div>
    {%- else %}
    <div class="picks">
      <span class="picks-lg">Your picks, from the add-on list</span>
      <div class="picks-line">
        <span class="slots" aria-hidden="true">
          {%- for n in range(0, t.picks.pages) %}<i class="slot"></i>{% endfor %}
        </span>
        <span class="picks-txt">{{ t.picks.pages }} page add-ons</span>
      </div>
      <div class="picks-line">
        <span class="slots" aria-hidden="true">
          {%- for n in range(0, t.picks.power) %}<i class="slot slot-hi"></i>{% endfor %}
        </span>
        <span class="picks-txt">{{ t.picks.power }} power feature{{ "s" if t.picks.power != 1 }}</span>
      </div>
      <a class="picks-link" href="/packages/add-ons/">See what you can pick</a>
    </div>
    {%- endif %}

    <a class="btn {% if t.recommended %}btn-gold{% else %}btn-ghost{% endif %} tier-cta" href="/contact/?package={{ t.slug }}">
      Start with {{ t.name }}
    </a>
  </article>
  {%- endfor %}
</div>

{#
  WHAT I BUILD: the build on the bench. Each business is one lit stage: the
  problem it solves and its price on the left, and on the right a blueprint
  screen whose slots are the build's own parts, from bundles.json. A
  Standard-based build fills exactly Standard's picks (packages.json:
  3 page add-ons, 1 power feature); the restaurant is its own fixed set.

  Where a disclosed demo exists for the trade (work.json `bundle`), its real
  screenshot sits faint behind the slots and its sampled light tints the
  floor (trades.ts). Without a demo the stage stays neutral: no client, no
  colour.

  Statically every business stands stacked and readable. With JavaScript
  (src/home/trades.ts) .h-trades becomes an ARIA tablist and each .h-fit
  its tabpanel.
#}
{%- set custom = packages.features | find("key", "custom") %}
{%- set hosting = packages.features | find("key", "hosting") %}
<section class="h-build h-wrap" id="build" aria-labelledby="build-h">
  <h2 id="build-h" class="h-h2 h-build-h">Built from the parts your business actually uses.</h2>

  <div class="h-build-stage" data-build-stage>
    <span class="key-cone" aria-hidden="true"></span>
    <span class="key-pool" aria-hidden="true"></span>

    <nav class="h-trades" aria-label="Type of business">
      {%- for b in bundles %}
      <a class="alv-lit-sel" href="#build-{{ b.slug }}" data-trade="{{ b.slug }}"><svg class="h-ic h-trade-ic" aria-hidden="true"><use href="#i-{{ b.icon }}"/></svg><span class="h-trade-name">{{ b.shortName }}</span></a>
      {%- endfor %}
    </nav>

    <div class="h-fits">
    {%- for b in bundles %}
    {%- set fixed = b.relation == "fixed" %}
    {%- set powers = [] %}
    {%- set pages = [] %}
    {%- for i in b.includes %}
    {%- if i.kind == "power" %}{% set powers = (powers.push(i), powers) %}{% else %}{% set pages = (pages.push(i), pages) %}{% endif %}
    {%- endfor %}
    {%- set demo = work.projects | find("bundle", b.slug) %}
    <article class="h-fit" id="build-{{ b.slug }}" data-fit="{{ b.slug }}" aria-labelledby="fit-{{ b.slug }}"{% if demo %} data-demo="{{ demo.screenshots.desktop.small or demo.screenshots.desktop.src }}"{% endif %}>
      <div class="h-fit-copy">
        <h3 id="fit-{{ b.slug }}" class="h-fit-name"><svg class="h-ic" aria-hidden="true"><use href="#i-{{ b.icon }}"/></svg>{{ b.name }}</h3>
        <p class="h-fit-trades">{{ b.trades }}</p>
        <p class="h-fit-line">{{ b.for }}</p>
        <p class="h-ticket"><b>{{ b.price | price | safe }}</b><span>{% if fixed %}A fixed, curated {{ b.shortName | lower }} build of its own{% else %}The {{ b.basedOn }} package, with these picks already made{% endif %}</span></p>
        <div class="h-fit-act">
          <a class="alv-btn alv-btn--sm" href="/contact/?package={{ b.slug }}">Start with this build</a>
          <a class="alv-tlink" href="/packages/for-your-business/#{{ b.slug }}">Explore this build</a>
        </div>
      </div>

      <figure class="h-bench">
        <div class="h-bp">
          {%- if demo %}
          <img class="h-bp-shot" src="{{ demo.screenshots.desktop.small or demo.screenshots.desktop.src }}" alt="" loading="lazy" decoding="async" />
          {%- endif %}
          <p class="h-bp-base"><span>Every build</span>{{ custom.label }}. {{ hosting.label }}.</p>
          <div class="h-slot-group">
            <p class="h-slot-label" id="slots-{{ b.slug }}-pages">{{ "Pages" if fixed else "Page add-ons" }}</p>
            <ul class="h-slots" aria-labelledby="slots-{{ b.slug }}-pages">
              {%- for i in pages %}
              <li class="h-slot" style="--i: {{ loop.index0 }}">{{ i.name }}</li>
              {%- endfor %}
            </ul>
          </div>
          <div class="h-slot-group">
            <p class="h-slot-label" id="slots-{{ b.slug }}-power">{{ "Power feature" if powers.length == 1 else "Power features" }}</p>
            <ul class="h-slots h-slots--power" aria-labelledby="slots-{{ b.slug }}-power">
              {%- for i in powers %}
              <li class="h-slot" style="--i: {{ pages.length + loop.index0 }}">{{ i.name }}</li>
              {%- endfor %}
            </ul>
          </div>
        </div>
        <span class="h-bench-floor" aria-hidden="true"></span>
        {%- if demo %}
        {%- set ch = work.chapters | find("project", demo.slug) %}
        <figcaption class="h-bench-cap"><span class="alv-tag">Demo build</span><a class="alv-tlink" href="/#work-{{ ch.id }}">{{ demo.name }}</a></figcaption>
        {%- endif %}
      </figure>
    </article>
    {%- endfor %}
    </div>
  </div>

  <p class="h-also">Beyond the site: logos, business cards and Google Business Profile setup. <a class="alv-tlink" href="/services/">Every service</a></p>
</section>

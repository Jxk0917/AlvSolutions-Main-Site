{#
  WHAT I BUILD. A concise business selector, not an inventory. bundles.json
  is the authority for every sentence, price and part. A "picks" build is a
  package with its picks made; a "fixed" build (the restaurant) is its own
  curated bundle and says so. Full inclusions live at
  /packages/for-your-business/; the full catalogue lives at
  /packages/add-ons/ — neither is repeated here.

  Each business shows at most 3 defining parts (power features first, then
  page add-ons), derived from bundles.json, with a route to the rest.

  Hooks for the animated picker (Phase 4E-B): .h-trades [data-trade],
  .h-fit [data-fit].
#}
<section class="h-build h-wrap" id="build" aria-labelledby="build-h">
  <div class="h-build-head">
    <h2 id="build-h" class="h-h2">Built from the parts your business actually uses.</h2>
    <p class="h-lede">Every site starts on the same foundation, then it's fitted to how your customers find you, decide and buy.</p>
  </div>

  <nav class="h-trades" aria-label="Type of business">
    {%- for b in bundles %}
    <a class="alv-lit-sel" href="#build-{{ b.slug }}" data-trade="{{ b.slug }}"><span class="h-trade-name">{{ b.shortName }}</span><span class="h-trade-sub">{{ b.trades }}</span></a>
    {%- endfor %}
  </nav>

  <div class="h-fits">
    {%- for b in bundles %}
    {%- set powers = [] %}
    {%- set pages = [] %}
    {%- for i in b.includes %}
    {%- if i.kind == "power" %}{% set powers = (powers.push(i), powers) %}{% else %}{% set pages = (pages.push(i), pages) %}{% endif %}
    {%- endfor %}
    {%- set ordered = powers.concat(pages) %}
    {%- set shown = ordered.slice(0, 3) %}
    {%- set remaining = ordered.length - shown.length %}
    <article class="h-fit" id="build-{{ b.slug }}" data-fit="{{ b.slug }}" aria-labelledby="fit-{{ b.slug }}">
      <div class="h-fit-why">
        <h3 id="fit-{{ b.slug }}" class="h-fit-name">{{ b.name }}</h3>
        <p class="h-fit-line">{{ b.for }}</p>
        <p class="h-fit-price">
          {%- if b.relation == "fixed" %}A fixed, curated {{ b.shortName | lower }} build of its own:
          {%- else %}The {{ b.basedOn }} package, with these picks already made:{% endif %}
          <b>{{ b.price | price | safe }}</b>
        </p>
        <div class="h-fit-act">
          <a class="alv-btn alv-btn--sm" href="/contact/?package={{ b.slug }}">Start with this build</a>
          <a class="alv-tlink" href="/packages/for-your-business/#{{ b.slug }}">Explore this build</a>
        </div>
      </div>
      <div class="h-fit-what">
        <ul class="h-fit-parts">
          {%- for i in shown %}
          <li><span class="h-part">{{ i.name }}</span><span class="h-part-kind">{{ "Power feature" if i.kind == "power" else "Page add-on" }}</span></li>
          {%- endfor %}
        </ul>
        {%- if remaining > 0 %}
        <a class="alv-tlink h-fit-more" href="/packages/for-your-business/#{{ b.slug }}">+{{ remaining }} more</a>
        {%- endif %}
      </div>
    </article>
    {%- endfor %}
  </div>

  <p class="h-also">Beyond the site: logos, business cards and Google Business Profile setup. <a class="alv-tlink" href="/services/">Every service</a></p>
</section>

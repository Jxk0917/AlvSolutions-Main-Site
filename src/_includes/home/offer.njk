{#
  WHAT IT TAKES: the pieces of running a business online, one card each,
  routing to its own service page. The homepage only names each piece and
  says what it does for the customer; everything else is on the page it
  links to. Each card's service (route and icon) is read from
  services.json by slug; only the short homepage wording lives here.

  The website is the centre, so it is the largest surface and the one the
  key light falls on. The rest are dark glass around it; pointing at one
  catches the key on its top edge (CSS only).

  Each card also carries its own coloured light (h1 -> h2, OKLCH hue
  angles) on its top edge, its icon and a faint wash in its corner. In
  reading order the five run as one spectrum, so the set reads as a
  single light split across the grid. Colour never touches the type.
#}
{%- set cards = [
  { slug: "business-websites", h1: 290, h2: 240, title: "A website built around your business", body: "Custom-coded, fast on a phone and written for how your customers search. You own the domain, and the finished site is yours once it is paid for." },
  { slug: "booking-integration", h1: 240, h2: 200, title: "Bookings and quote requests", body: "Customers book a time or ask for a quote at any hour, without phone tag." },
  { slug: "google-business-profile", h1: 200, h2: 155, title: "Found on Google", body: "Your Business Profile, set up in your own Google account so the listing stays yours." },
  { slug: "care-plans", h1: 155, h2: 100, title: "Hosting and upkeep", body: "Hosting, SSL, backups and monthly edits handled for you, from " + (careplans.plans[0].price | price) + "/mo." },
  { slug: "logo-design", h1: 100, h2: 40, title: "Logo and business cards", body: "A logo that works on screen, and cards that match the site in hand.", href: "/services/#branding-design" }
] %}
{%- set foundation = packages.tiers[0] %}
<section class="h-offer h-wrap" id="services" aria-labelledby="offer-h">
  <div class="h-offer-head">
    <h2 id="offer-h" class="h-h2">Everything it takes to run a business online.</h2>
    <p class="h-lede">The site is the centre. These are the parts around it, handled by the same person.</p>
  </div>

  <ul class="h-offer-grid">
    {%- for c in cards %}
    {%- set svc = services | find("slug", c.slug) %}
    <li class="h-card{% if loop.first %} h-card--lead{% endif %}" style="--h1: {{ c.h1 }}; --h2: {{ c.h2 }}">
      {%- if loop.first %}<span class="key-cone" aria-hidden="true"></span>{% endif %}
      <svg class="h-ic h-card-ic" aria-hidden="true"><use href="#i-{{ svc.icon }}"/></svg>
      <h3 class="h-card-h"><a class="h-card-link" href="{{ c.href or ('/services/' + svc.slug + '/') }}">{{ c.title }}</a></h3>
      <p class="h-card-body">{{ c.body | safe }}</p>
      {%- if loop.first %}
      {#- What every package includes, read from Foundation's own facts. #}
      <ul class="h-feats h-card-feats" aria-label="In every package">
        {%- for f in packages.features %}
        {%- if foundation.has[f.key] and not (f.key in ["pages", "custom", "revisions"]) %}<li>{{ f.label }}</li>{% endif %}
        {%- endfor %}
      </ul>
      {%- endif %}
      <svg class="h-ic h-card-go" aria-hidden="true"><use href="#i-arrow"/></svg>
    </li>
    {%- endfor %}
  </ul>

  <p class="h-offer-all"><a class="alv-tlink" href="/services/">Every service and its price</a></p>
</section>

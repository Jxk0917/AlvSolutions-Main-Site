{#
  SERVICES: the three things ALVSolutions makes for a business, shown as
  one business (Hacienda Grill) carried across all three. No cards: each
  service is a station standing on one shared, lit floor, its work under
  its own spotlight, its words beneath the floor. The website is the
  flagship and the widest station; the Instagram profile and the flyer
  stand beside it, each sized to its own silhouette.

  Light, not boxes: a cone from above, the client's warm colour behind the
  work, and a length of the site's blue bar glowing on the floor under it.
  Pointing at a station hands the key light to it (its cone and bar come
  up, its work lifts) while the other two settle back. The lights come up
  as the row reaches the viewport (home/services.ts); without JS, or with
  motion off, they are simply on. Each station is one link to the page
  that owns the detail. No prices here: the website packages follow.
#}
{%- set hac = work.projects | find("slug", "hacienda-grill") %}
{%- set hg = "/assets/showcase/hacienda/" %}
{%- set cards = [
  { key: "web", title: "Websites",
    body: "Custom sites designed around your customers, services and goals. Never a recycled template.",
    items: ["Custom-built", "Mobile-first", "Booking & quotes", "Google-ready"],
    cta: "Explore websites", href: "/services/#websites" },
  { key: "brand", title: "Branding & social presence",
    body: "Logos, visual identity and social graphics that make your business look the same everywhere.",
    items: ["Logo design", "Brand identity", "Social graphics", "Profile visuals"],
    cta: "Explore branding", href: "/services/#branding-design" },
  { key: "print", title: "Business graphics",
    body: "Business cards, menus, flyers and branded materials that carry your brand beyond the website.",
    items: ["Business cards", "Menus", "Flyers", "Custom graphics"],
    cta: "Explore business graphics", href: "/services/custom-business-graphics/" }
] %}
<section class="h-offer h-wrap" id="services" aria-labelledby="offer-h">
  <div class="h-offer-head">
    <p class="h-eyebrow">Services</p>
    <h2 id="offer-h" class="h-h2">Built for the whole business.</h2>
    <p class="h-lede">From the website people land on to the brand they remember and the materials they take with them.</p>
  </div>

  <div class="h-svc-row" data-svc>
    <span class="h-svc-floor" aria-hidden="true"></span>
    {%- for c in cards %}
    <article class="h-svc h-svc--{{ c.key }}" aria-labelledby="svc-{{ c.key }}">
      <div class="h-svc-stage" data-deal="fade">
        <span class="h-svc-cone" aria-hidden="true"></span>
        <span class="h-svc-bloom" aria-hidden="true"></span>
        <div class="h-svc-art">
          {%- if c.key == "web" %}
          {%- set d = hac.screenshots.desktop %}{% set m = hac.screenshots.mobile %}
          <div class="h-svc-glass h-svc-glass--desk">
            <span class="h-svc-chrome" aria-hidden="true"><i></i><i></i><i></i><b></b></span>
            <img src="{{ d.src }}" srcset="{{ d.small }} 720w, {{ d.src }} 1440w" sizes="(min-width: 1101px) 34vw, (min-width: 761px) 70vw, 86vw" width="{{ d.width }}" height="{{ d.height }}" alt="{{ d.alt }}" loading="lazy" decoding="async" />
          </div>
          <div class="h-svc-glass h-svc-glass--phone">
            <img src="{{ m.src }}" width="{{ m.width }}" height="{{ m.height }}" alt="{{ m.alt }}" loading="lazy" decoding="async" />
          </div>
          {%- elif c.key == "brand" %}
          <div class="h-svc-glass h-svc-glass--ig">
            <img src="{{ hg }}hg-ig-profile-screen-1170.webp" srcset="{{ hg }}hg-ig-profile-screen-780.webp 780w, {{ hg }}hg-ig-profile-screen-1170.webp 1170w" sizes="(min-width: 761px) 220px, 46vw" width="1170" height="2532" alt="Hacienda Grill's Instagram profile: its logo, bio, story highlights and a grid of branded posts" loading="lazy" decoding="async" />
          </div>
          {%- else %}
          <div class="h-svc-sheet">
            <img src="{{ hg }}hg-flyer-1275.webp" srcset="{{ hg }}hg-flyer-638.webp 638w, {{ hg }}hg-flyer-1275.webp 1275w" sizes="(min-width: 761px) 300px, 62vw" width="1275" height="1650" alt="Hacienda Grill's birria tacos flyer" loading="lazy" decoding="async" />
          </div>
          {%- endif %}
        </div>
      </div>
      <div class="h-svc-copy" data-deal="unit">
        <h3 id="svc-{{ c.key }}" class="h-svc-title">{{ c.title }}</h3>
        <p class="h-svc-body">{{ c.body }}</p>
        <ul class="h-svc-items">
          {%- for i in c.items %}<li>{{ i }}</li>{% endfor %}
        </ul>
        <a class="h-svc-cta" href="{{ c.href }}">{{ c.cta }}<svg class="h-ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </article>
    {%- endfor %}
  </div>
</section>

<script>
  /* Homepage, before first paint. Decides whether the work reel is held and
     whether the opening plays, so neither flashes in after the page has
     drawn. Mirrors src/home/reel-geometry.ts (layoutFor / geoFor) and the
     session key in src/home/opening.ts. Without JS none of this runs and the
     static page is untouched. If the enhancement has not taken over within
     4.5s (script blocked, failed or very slow) the static page comes back. */
  (function () {
    var r = document.documentElement;
    if (/\bno-motion\b/.test(r.className)) return;
    var w = innerWidth, h = innerHeight;
    var held = w >= 761 && h >= 560;
    r.setAttribute("data-geo", held ? (w / h < 0.85 ? "portrait" : "wide") : "narrow");
    r.className += " alv-enhance" + (held ? " alv-reel" : "");
    var seen = false;
    try { seen = sessionStorage.getItem("alv-home-opened") === "1"; } catch (e) {}
    if (!seen && !location.hash) r.className += " alv-opening";
    setTimeout(function () {
      if (window.__alvHomeReady) return;
      r.classList.remove("alv-enhance", "alv-reel", "alv-opening");
      r.classList.add("alv-failsafe");
    }, 4500);
  })();
</script>

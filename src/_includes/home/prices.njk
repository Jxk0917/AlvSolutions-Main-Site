{#
  PRICES: a decision point, not the price book. Three rows only - pages,
  revision rounds, picks - read across Foundation/Standard/Complete from
  packages.json. Care, extras and the full comparison route to their
  dedicated pages rather than repeating here.

  Statically it is a real form: a native radio group (name="package") in the
  column heads, Standard checked, submitting by GET to /contact/ so the
  wizard receives ?package=<tier> with no JS. The three heads stand on one
  floor line and the room's own key light falls on the chosen one: :has()
  at rest, src/home/prices.ts (the same .key-cone/.key-pool) with JS.

  The Founders Special follows as its own section (index.html).
#}
{%- set rowKeys = ["pages", "revisions", "seo", "addons", "power"] %}
{%- set foundation = packages.tiers[0] %}
<section class="h-prices h-wrap" id="prices" aria-labelledby="prices-h">
  <div class="h-prices-head">
    <h2 id="prices-h" class="h-h2">One flat price, agreed before any work starts.</h2>
    <p class="h-lede">Three packages. Everything each one covers is written down before I begin, and if the job grows you approve the figure first.</p>
  </div>

  <form class="h-cmp-form" action="/contact/" method="get">
    <fieldset class="h-cmp-set">
      <legend class="alv-sr-only">Choose a package</legend>
      <div class="h-cmp" role="table" aria-label="Packages compared" data-cmp>
        <span class="key-cone" aria-hidden="true"></span>
        <span class="key-pool" aria-hidden="true"></span>
        <div role="rowgroup">
          <div class="h-cmp-row h-cmp-head" role="row" data-cmp-head>
            <span class="h-cmp-corner" role="columnheader"><span class="alv-sr-only">Package</span></span>
            {%- for t in packages.tiers %}
            <div class="h-cmp-col" role="columnheader" data-col="{{ t.slug }}">
              <label class="h-tier" data-tier="{{ t.slug }}">
                <input class="h-tier-input" type="radio" name="package" value="{{ t.slug }}"{% if t.recommended %} checked{% endif %} />
                <span class="h-tier-mark">{% if t.recommended %}Recommended{% endif %}</span>
                <span class="h-tier-name">{{ t.name }}</span>
                <span class="h-tier-price">{{ t.price | price | safe }}</span>
                <span class="h-tier-for">{{ t.for }}</span>
                <span class="h-tier-state" aria-hidden="true"><span class="h-state-on">Your choice</span><span class="h-state-off">Choose<span class="h-state-name"> {{ t.name }}</span></span></span>
              </label>
            </div>
            {%- endfor %}
          </div>
        </div>

        <div class="h-cmp-body" role="rowgroup">
          <div class="h-cmp-row" role="row">
            <span class="h-cmp-label" role="rowheader">Pages</span>
            {%- for t in packages.tiers %}
            <span class="h-cmp-cell" role="cell" data-col="{{ t.slug }}">{{ t.has.pages }}</span>
            {%- endfor %}
          </div>
          <div class="h-cmp-row" role="row">
            <span class="h-cmp-label" role="rowheader">Revision rounds</span>
            {%- for t in packages.tiers %}
            <span class="h-cmp-cell" role="cell" data-col="{{ t.slug }}">{{ t.has.revisions }}</span>
            {%- endfor %}
          </div>
          <div class="h-cmp-row" role="row">
            <span class="h-cmp-label" role="rowheader">Your picks</span>
            {%- for t in packages.tiers %}
            <span class="h-cmp-cell" role="cell" data-col="{{ t.slug }}">
              {%- if t.picks %}{{ t.picks.pages }} page add-on{{ "s" if t.picks.pages != 1 }}, {{ t.picks.power }} power feature{{ "s" if t.picks.power != 1 }}
              {%- else %}<span class="h-cmp-none" aria-hidden="true"></span><span class="alv-sr-only">None</span>{% endif -%}
            </span>
            {%- endfor %}
          </div>
        </div>
      </div>
    </fieldset>

    <div class="h-prices-act">
      <button class="alv-btn" type="submit">Start with this package</button>
      <a class="alv-tlink" href="/packages/">Full comparison</a>
    </div>
  </form>

  {#- Every package builds on Foundation, so whatever is true of Foundation
      and does not vary by tier (the row keys above are excluded) holds for
      all three: read from Foundation's own facts, not a separate list. #}
  {%- set baseline = [] %}
  {%- for f in packages.features %}
  {%- if not (f.key in rowKeys) and foundation.has[f.key] %}{% set baseline = (baseline.push(f.label), baseline) %}{% endif %}
  {%- endfor %}
  <div class="h-facts">
    <p class="h-fact"><span class="h-fact-k">Every package</span>{{ baseline | join(", ") }}.</p>
    <p class="h-fact"><span class="h-fact-k">Every build takes a care plan</span>Host {{ careplans.plans[0].price | price | safe }}/mo, Grow {{ careplans.plans[1].price | price | safe }}/mo. {{ careplans.minimum }} <a class="alv-tlink" href="/packages/#care">Care plan details</a></p>
  </div>
</section>

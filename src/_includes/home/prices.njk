{#
  PACKAGES: a decision point, not the price book. Each of the three packages
  is a column head on one floor line - name, price, who it is for and its
  three deciding facts - read from packages.json. The full comparison and care
  plans live on /packages/.

  Statically it is a real form: a native radio group (name="package"),
  Standard checked, submitting by GET to /contact/ so the wizard receives
  ?package=<tier> with no JS. At rest the chosen column carries its own lit
  bar and a still cone (:has()). With JS (src/home/picker.ts) the room's
  key light glides to the package under attention and one glowing
  selection bar glides along the floor to the package chosen.

  The same picker, smaller, carries the four industry builds (builds.njk).
#}
<section class="h-prices h-wrap" id="prices" aria-labelledby="prices-h">
  <div class="h-prices-head">
    <h2 id="prices-h" class="h-h2">One flat price, agreed before any work starts.</h2>
    <p class="h-lede">Three packages. Everything each one covers is written down before I begin.</p>
  </div>

  <form class="h-pick-form" action="/contact/" method="get">
    <fieldset class="h-pick-set">
      <legend class="alv-sr-only">Choose a package</legend>
      <div class="h-pick h-pick--tiers" data-pick>
        <span class="key-cone" aria-hidden="true"></span>
        <span class="key-pool" aria-hidden="true"></span>
        <div class="h-pick-row" data-pick-row>
          {%- for t in packages.tiers %}
          <label class="h-opt" data-opt="{{ t.slug }}">
            <input class="h-opt-input" type="radio" name="package" value="{{ t.slug }}"{% if t.recommended %} checked{% endif %} />
            <span class="h-opt-mark">{% if t.recommended %}Recommended{% endif %}</span>
            <span class="h-opt-name">{{ t.name }}</span>
            <span class="h-opt-price">{{ t.price | price | safe }}</span>
            <span class="h-opt-for">{{ t.for }}</span>
            <span class="h-opt-facts">
              <span>{{ t.has.pages }} pages</span>
              <span>{{ t.has.revisions }} revision round{{ "s" if t.has.revisions != "1" }}</span>
              {%- if t.picks %}
              <span>{{ t.picks.pages }} page add-ons, {{ t.picks.power }} power feature{{ "s" if t.picks.power != 1 }}</span>
              {%- endif %}
            </span>
            <span class="h-opt-state" aria-hidden="true"><span class="h-state-on">Your choice</span><span class="h-state-off">Choose<span class="h-state-name"> {{ t.name }}</span></span></span>
          </label>
          {%- endfor %}
        </div>
        <span class="h-pick-bar" aria-hidden="true"></span>
      </div>
    </fieldset>

    <div class="h-pick-act">
      <button class="alv-btn" type="submit">Start with this package</button>
      <a class="alv-tlink" href="/packages/#compare">Compare every feature</a>
    </div>
  </form>

  <p class="h-prices-note">Every build also takes a care plan for hosting and upkeep, from {{ careplans.plans[0].price | price | safe }}/mo. <a class="alv-tlink" href="/packages/#care">How care plans work</a></p>
</section>

{#
  HOW A PROJECT RUNS: one project, one line. The three clauses read across
  as one sentence; beneath each, a station on a single rail with its detail
  and its payment note, from process.json. The notes are the payment
  timeline, so the section shows how money moves through a project too.

  Statically (no JS, or reduced motion) every clause is lit and the room is
  on. With motion (src/home/process.ts) each clause lights as the visitor
  scrolls past its [data-mark]; nothing is pinned and nothing waits.
#}
<section class="h-process h-wrap" id="process" aria-labelledby="process-h">
  <span class="key-cone" aria-hidden="true"></span>
  <span class="key-pool" aria-hidden="true"></span>
  <h2 id="process-h" class="h-proc-h">How a project runs.</h2>
  <ol class="h-line">
    {%- for s in process.steps %}
    <li class="h-stn" data-stn>
      <h3 class="h-stn-clause">{{ s.clause }}</h3>
      <span class="h-stn-node" aria-hidden="true"><i></i></span>
      <div class="h-stn-body">
        <svg class="h-ic" aria-hidden="true"><use href="#i-{{ s.icon }}"/></svg>
        <p>{{ s.detail }}</p>
        <p class="alv-tag h-stn-note">{{ s.note }}</p>
      </div>
    </li>
    {%- endfor %}
  </ol>
  {%- for s in process.steps %}
  <span class="h-proc-mark" data-mark style="--m: {{ loop.index0 }}" aria-hidden="true"></span>
  {%- endfor %}
</section>

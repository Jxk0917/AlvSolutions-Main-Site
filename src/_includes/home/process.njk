{#
  HOW A PROJECT RUNS, from process.json. In the locked design the three
  clauses are held as one sentence and lit one by one, with only the current
  step's detail shown. Statically, the sentence rests fully lit (its end
  state) and every step keeps its detail and payment note visible.

  Hooks for the held sentence (Phase 4E): [data-proc-stage], [data-process],
  .h-p / .h-p-title / .h-p-detail, and the .h-proc-track steps.
#}
<section class="h-process" id="process" aria-labelledby="process-h">
  <div class="h-proc-stage" data-proc-stage>
    <span class="key-cone" aria-hidden="true"></span>
    <span class="key-pool" aria-hidden="true"></span>
    <div class="h-wrap h-proc-inner">
      <h2 id="process-h" class="h-proc-h">How a project runs.</h2>
      <ol class="h-proc" data-process>
        {%- for s in process.steps %}
        <li class="h-p">
          <h3 class="h-p-title">{{ s.clause }} </h3>
          <div class="h-p-detail">
            <p class="h-p-body">{{ s.detail }}</p>
            <p class="h-p-meta">{{ s.note }}</p>
          </div>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </div>
  <div class="h-proc-track" aria-hidden="true">
    {%- for s in process.steps %}<span data-pstep="{{ loop.index0 }}"></span>{% endfor %}
  </div>
</section>

{#
  WHAT YOU CAN HOLD ME TO. Short, spaced promises — not full policy
  explanations. Each line reads policies.json's `short` field (falling back
  to `title` if a slug has none), so nothing here is worded twice: the full
  body for every policy lives at /policies/.
#}
{%- set homePolicies = ["domain", "payment", "scope", "revisions", "cancel"] %}
<section class="h-terms h-wrap" id="terms" aria-labelledby="terms-h">
  <div class="h-terms-head">
    <div>
      <h2 id="terms-h" class="h-h2">What you can hold me to.</h2>
      <p class="h-lede">ALVSolutions is new, so there are no reviews to show you yet. These are the terms every project runs on instead.</p>
    </div>
    <p class="h-one">A direct line to the person building your site. A real person, not a ticket.</p>
  </div>
  <ul class="h-promises">
    {%- for slug in homePolicies %}
    {%- set pol = policies.policies | find("slug", slug) %}
    <li>{{ pol.short or pol.title }}</li>
    {%- endfor %}
  </ul>
  <p class="h-terms-more"><a class="alv-tlink" href="/policies/">Every policy, in full</a></p>
</section>

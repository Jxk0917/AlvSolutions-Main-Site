<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {#- Centralised here so a brand rename or domain switch is one edit in
      site.json rather than a search-and-replace across every meta tag. -#}
  {%- set metaTitle = title and (title + " | " + site.name) or (site.name + " | Professional Websites for Local Businesses") %}
  {%- set metaDesc = description | default("Professional websites built around how your business gets customers. Flat-price builds from " + site.startingPrice + ", live in " + site.turnaround + ", with hosting and support from " + site.carePlanFrom + ". " + site.city + ".") %}
  {%- set canonicalUrl = site.url + page.url %}

  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDesc }}" />
  <meta name="theme-color" content="#070C14" />
  <link rel="canonical" href="{{ canonicalUrl }}" />
  {#- Utility pages like /connect/ (a QR/business-card landing page) opt out of
      search indexing per-page without touching robots.txt or any other page. #}
  {%- if noindex %}
  <meta name="robots" content="noindex, follow" />
  {%- endif %}

  <meta property="og:title" content="{{ metaTitle }}" />
  <meta property="og:description" content="{{ metaDesc }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ canonicalUrl }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:image" content="{{ site.url }}/assets/brand/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ metaTitle }}" />
  <meta name="twitter:description" content="{{ metaDesc }}" />

  {#- Sitewide business identity. Deliberately omits telephone, address and
      sameAs: ALVSolutions has no public phone, street address or social
      profiles yet, and inventing any of them is worse than leaving them out. #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "email": "{{ site.email }}",
    "image": "{{ site.url }}/assets/brand/og-image.png",
    "logo": "{{ site.url }}/assets/brand/alv-badge-256.png",
    "description": "{{ site.tagline }}",
    "areaServed": {
      "@type": "City",
      "name": "{{ site.city }}"
    }
  }
  </script>
  <!-- Brand kit favicon: white mark on Deep Blue, legible in light and dark tabs.
       PNG fallback for browsers without SVG favicons. -->
  <link rel="icon" href="/assets/brand/alv-favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/brand/alv-favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/assets/brand/alv-badge-256.png" />

  <!-- Self-hosted variable fonts: Manrope for headings, Geist for body. Preloaded
       because they are declared inside styles.css, so without this the browser
       cannot discover either file until the stylesheet has finished parsing. -->
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Manrope-Variable.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Geist-Variable.woff2" crossorigin />
  {%- if preloadImage %}
  <link rel="preload" as="image" href="{{ preloadImage }}" />
  {%- endif %}

  <link rel="stylesheet" href="/assets/styles.css" />
  <link rel="stylesheet" href="/assets/pages.css" />
</head>
<body>

<a class="skip" href="#main">Skip to content</a>

{% include "components/icon-sprite.njk" %}
{%- if not hideChrome %}
{% include "components/nav.njk" %}
{%- endif %}

{{ content | safe }}

{%- if not hideChrome %}
{% include "components/footer.njk" %}
{%- endif %}

<script src="/assets/main.js" defer></script>
{%- if shader %}
<script src="/assets/shader.js" defer></script>
{%- endif %}
</body>
</html>

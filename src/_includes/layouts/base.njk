<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Motion environment, read before first paint so no transition ever
       runs and is then snapped off: mirrors src/motion/env.ts's own
       storage key and reduced-motion check. -->
  <script>
    (function () {
      var r = document.documentElement;
      try {
        var pref = localStorage.getItem("alv-motion");
        if (pref === "off" || (pref !== "on" && matchMedia("(prefers-reduced-motion: reduce)").matches)) {
          r.className += " no-motion";
        } else {
          /* motion/deal.ts deals text in. */
          r.className += " alv-deal";
        }
      } catch (e) {}
    })();
  </script>
  {%- if prepaint %}
  {% include prepaint %}
  {%- endif %}

  {#- Centralised here so a brand rename or domain switch is one edit in
      site.json rather than a search-and-replace across every meta tag. -#}
  {%- set metaTitle = title and (title + " | " + site.name) or (site.name + " | Professional Websites for Local Businesses") %}
  {%- set metaDesc = description | default("Professional websites built around how your business gets customers. Flat-price builds from " + site.startingPrice + ", typically live " + site.turnaround + " after your content arrives, with hosting and support from " + site.carePlanFrom + ". " + site.city + ".") %}
  {%- set canonicalUrl = site.url + page.url %}

  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDesc }}" />
  <meta name="theme-color" content="{{ themeColor or '#0B0B0B' }}" />
  <link rel="canonical" href="{{ canonicalUrl }}" />
  {#- Utility pages like /connect/ (a QR/business-card landing page) opt out of
      search indexing per-page without touching robots.txt or any other page. #}
  {%- if noindex %}
  <meta name="robots" content="noindex, follow" />
  {%- endif %}

  <meta property="og:title" content="{{ metaTitle }}" />
  <meta property="og:description" content="{{ metaDesc }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ canonicalUrl }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:image" content="{{ site.url }}/assets/brand/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ metaTitle }}" />
  <meta name="twitter:description" content="{{ metaDesc }}" />

  {#- Sitewide business identity. Deliberately omits telephone, address and
      sameAs: ALVSolutions has no public phone, street address or social
      profiles yet, and inventing any of them is worse than leaving them out. #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "email": "{{ site.email }}",
    "image": "{{ site.url }}/assets/brand/og-image.png",
    "logo": "{{ site.url }}/assets/brand/alv-badge-256.png",
    "description": "{{ site.tagline }}",
    "areaServed": {
      "@type": "City",
      "name": "{{ site.city }}"
    }
  }
  </script>
  <!-- The ALV symbol. The SVG flips its ink with the tab's colour scheme; the
       PNGs (light symbol on the room tile) are for browsers without SVG
       favicons, search results and iOS. Built by Brand_Assets/tools/build-favicons.mjs. -->
  <link rel="icon" href="/assets/brand/alv-favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/brand/alv-favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/assets/brand/alv-favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="apple-touch-icon" href="/assets/brand/alv-badge-180.png" />

  <!-- Screen Light typography, self-hosted. The two upright faces are
       preloaded: they are declared inside the stylesheet, so without this the
       browser cannot discover them until it has finished parsing it. -->
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Bricolage-Grotesque-Variable.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Instrument-Sans-Variable.woff2" crossorigin />
  <!-- Archivo sets the logo's wordmark in every header and footer, and nothing
       else, so it is preloaded for the same reason (declared in the stylesheet). -->
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Archivo-Variable.woff2" crossorigin />
  <!-- Italic is self-hosted and available via @font-face (the signing
       treatment), but it's used sparingly enough not to earn a preload. -->
  {%- if preloadImage %}
  <link rel="preload" as="image" href="{{ preloadImage }}" />
  {%- endif %}

  <link rel="stylesheet" href="/assets/dist/site.css" />
  {%- if pageCss %}
  <link rel="stylesheet" href="/assets/dist/{{ pageCss }}.css" />
  {%- endif %}
</head>
<body>

<a class="alv-skip" href="#main">Skip to content</a>

{% include "components/icon-sprite.njk" %}
{%- if not hideChrome %}
{% include "components/nav.njk" %}
{%- endif %}

{{ content | safe }}

{%- if not hideChrome %}
{% include "components/footer.njk" %}
{%- endif %}

<script src="/assets/dist/site.js" defer></script>
{%- if pageJs %}
<script src="/assets/dist/{{ pageJs }}.js" defer></script>
{%- endif %}
</body>
</html>

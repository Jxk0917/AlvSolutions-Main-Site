---js
{
  layout: "layouts/interior.njk",
  pagination: { data: "bundles", size: 1, alias: "bld", addAllPagesToCollections: true },
  permalink: "/builds/{{ bld.slug }}/",
  eleventyComputed: {
    title: (data) => data.bld.name,
    description: (data) => `${data.bld.name}, a website build for ${data.bld.trades.toLowerCase()}. ${data.bld.brief} $${data.bld.price.toLocaleString("en-US")} one-time.`,
    // The build's parts, grouped the way the blueprint screen lays them out.
    groups: (data) => [
      { label: "Pages", cls: "", items: data.bld.includes.filter((i) => i.kind === "page") },
      { label: "Power features", cls: " int-slots--power", items: data.bld.includes.filter((i) => i.kind === "power") },
      { label: "Included", cls: "", items: data.bld.includes.filter((i) => i.kind !== "page" && i.kind !== "power") },
    ].filter((g) => g.items.length),
    // The header band (layouts/interior.njk), in this build's own light: its
    // trade hue from bundles.json, as on the index and the homepage picker.
    head: (data) => {
      const b = data.bld;
      return {
        hue: b.hue,
        icon: b.icon,
        back: { label: "Back to industry builds", url: "/builds/" },
        crumbs: [{ label: "Industry builds", url: "/builds/" }, { label: b.name }],
        heading: b.name,
        lede: b.for,
        actions: [
          { label: `Start with ${b.shortName}`, url: `/contact/?package=${b.slug}` },
          { label: "Compare all four builds", url: "/builds/" },
        ],
      };
    },
    cta: (data) => ({
      heading: `Start with ${data.bld.shortName}?`,
      lede: "Tell me what the business does. If it needs one swap, I will say which, and the price is agreed before any work starts.",
      actions: [
        { label: `Start with ${data.bld.shortName}`, url: `/contact/?package=${data.bld.slug}` },
        { label: "See all prices", url: "/pricing/" },
      ],
    }),
  },
}
---
{#
  ONE BUILD (/builds/<slug>/): the page behind each card on /builds/. The
  builds are the industry-build system ("Industry builds"); the portfolio of
  concept sites is What I Build (/work/), and every price is owned by /pricing/.
    1. what is in it: the build's own parts as slots (the blueprint screen,
       interior.css), beside its price and who it is for;
    2. for the three builds that are the Standard package with the picks
       made, what that package brings, read from packages.json;
    3. where a concept site for the trade exists in Work, a pointer to it;
    4. the other three builds.
  Every name, price, trade and inclusion is read from _data (bundles.json,
  packages.json, careplans.json). Nothing here is written per build.
#}
{%- set base = (packages.tiers | find("name", bld.basedOn)) if bld.basedOn else null %}
{%- set concept = (work.projects | find("slug", bld.concept)) if bld.concept else null %}

<section class="int-wrap bd-sec" aria-labelledby="bd-in-h">
  <h2 id="bd-in-h" class="int-h2">What is in it</h2>
  <div class="bd-grid">
    <div class="int-bp" style="--hue: {{ bld.hue }}">
      <p class="int-bp-base">
        {%- if base %}<span>{{ base.name }} package</span> with the picks already made.
        {%- else %}<span>A fixed, curated build of its own.</span> What is listed is what is included.{% endif %}
      </p>
      {%- for g in groups %}
      <div class="int-slot-group">
        <p class="int-slot-label">{{ g.label }}</p>
        <ul class="int-slots{{ g.cls }}">
          {%- for i in g.items %}
          <li class="int-slot">{{ i.name }}</li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>

    <div class="bd-side">
      <div class="int-ticket">
        <b>{{ bld.price | price | safe }}</b>
        <span>one-time. Every build also needs a care plan, from {{ careplans.plans[0].price | price | safe }} a month.</span>
      </div>
      <div class="bd-for">
        <h3 class="bd-for-h">Built for</h3>
        <p class="bd-trades">{{ bld.trades }}</p>
        <p>{{ bld.for }}</p>
      </div>
    </div>
  </div>
</section>

{%- if base %}
<section class="int-wrap bd-sec" aria-labelledby="bd-base-h">
  <h2 id="bd-base-h" class="int-h2">What the {{ base.name }} package brings</h2>
  <p class="bd-lede">The picks above are made for you. The rest is the package, exactly as on the <a href="/packages/#{{ base.slug }}">packages page</a>.</p>
  <dl class="bd-facts">
    {%- for f in packages.features %}
    {%- set v = base.has[f.key] %}
    {%- if v %}
    <div class="bd-fact">
      <dt>{{ f.label }}</dt>
      <dd>{% if v === true %}Included{% else %}{{ v }}{% endif %}</dd>
    </div>
    {%- endif %}
    {%- endfor %}
  </dl>
</section>
{%- endif %}

{%- if concept %}
<section class="int-wrap bd-sec" aria-labelledby="bd-work-h">
  <div class="int-sheet bd-work">
    <h2 id="bd-work-h" class="int-h2">See a concept site for this trade</h2>
    <p>{{ concept.name }} is a concept build for {{ concept.showcase.business | default("this kind of business") }}, shown in What I Build. It is fictional, made to show the finished work.</p>
    <div class="int-cta-act">
      <a class="alv-tlink" href="/work/#{{ concept.slug }}">See {{ concept.name }} in What I Build</a>
    </div>
  </div>
</section>
{%- endif %}

<section class="int-wrap bd-sec" aria-labelledby="bd-others-h">
  <h2 id="bd-others-h" class="int-h2">The other builds</h2>
  <ul class="bd-others">
    {%- for o in bundles %}{% if o.slug != bld.slug %}
    <li>
      <a class="int-card bd-other" href="/builds/{{ o.slug }}/" style="--hue: {{ o.hue }}">
        <span class="bd-other-top">
          <svg class="int-ic bd-other-ic" aria-hidden="true"><use href="#i-{{ o.icon }}"/></svg>
          <span class="int-card-h">{{ o.name }}</span>
        </span>
        <span class="int-card-body">{{ o.brief }}</span>
        <span class="int-card-meta"><span>{{ o.price | price | safe }} one-time</span></span>
      </a>
    </li>
    {%- endif %}{% endfor %}
  </ul>
</section>

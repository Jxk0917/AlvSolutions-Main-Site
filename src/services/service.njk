---
layout: layouts/base.njk
pagination:
  data: services
  size: 1
  alias: svc
  addAllPagesToCollections: true
permalink: "/services/{{ svc.slug }}/"
eleventyComputed:
  title: "{{ svc.name }}"
  description: "{{ svc.promise }}"
---

{%- set famLabel = { web: "Websites", brand: "Branding & design", care: "Care & visibility", print: "Print & apparel" } -%}
{%- set fam = famLabel[svc.family] -%}
{%- set p = svc.pricing -%}

{#- ─────────── normalise pricing into the picker's `tiers` shape ───────────
    The picker takes [{ label, price, unit, note, shot, rows }] and does not
    care where any of it came from. Only `kind: "levels"` produces tiers; every
    other kind renders as a single aside card instead, because one number does
    not need a tab strip. -#}
{%- set tiers = [] -%}
{%- set hasFactors = false -%}
{%- set cmpFactors = p.factors or [] -%}
{%- set cmpName = p.cmpName or (svc.name | lower) -%}

{%- if p.kind == "levels" -%}
  {%- set hasFactors = true if p.factors else false -%}
  {%- for l in p.levels -%}
    {%- set li = loop.index0 -%}
    {%- set rows = [] -%}
    {%- for f in (p.factors or []) -%}
      {%- set rows = (rows.push({ label: f.label, value: f.values[li], example: f.example }), rows) -%}
    {%- endfor -%}
    {%- set tiers = (tiers.push({ label: l.label, price: l.price, unit: l.unit,
                                  note: l.note, shot: l.shot, rows: rows, addon: l.addon }), tiers) -%}
  {%- endfor -%}
{%- endif -%}
{%- set ptid = svc.slug -%}
{#- a plain `set` inside a for loop stays in the loop's scope; mutating an
    array is what survives, so the flag is counted rather than assigned. -#}
{%- set shotFlags = [] -%}
{%- for t in tiers -%}{% if t.shot %}{% set shotFlags = (shotFlags.push(1), shotFlags) %}{% endif %}{%- endfor -%}
{%- set hasShots = shotFlags.length > 0 -%}

{%- set ph = {
  heading: svc.name,
  lead: svc.promise,
  back: { label: "Services", url: "/services/" },
  crumbs: [{ label: "Services", url: "/services/" }, { label: svc.name }],
  actions: [
    { label: "Start a project", url: ("/contact/?service=" + svc.slug) if svc.family == "brand" else "/contact/" },
    ({ label: "See price list", url: "/pricing/#brand-and-design", style: "btn-ghost" }) if svc.family == "brand"
      else ({ label: "See packages", url: "/packages/", style: "btn-ghost" })
  ]
} -%}
{% include "components/pagehead.njk" %}

<main id="main">

  {#- ══════════════ ONE SECTION: cost on the left, the case on the right ═════
      Side by side, the factor list answers "what will mine cost" while the
      prose beside it answers "what is it", and neither has to be scrolled past
      to reach the other. -#}
  <section class="sec">
    <div class="wrap">
      <div class="svc-split">

        <!-- ──────── left: what it costs ──────── -->
        <div class="svc-money">

          {%- if tiers.length %}
          <div class="sec-head reveal" style="margin-bottom: 20px;">
            <h2 class="svc-h2">Two levels, and the rule for each.</h2>
            {%- if hasShots %}
            <p class="body-3" style="margin-top: 12px;">
              Both designed against the same brand as your site. The cards below
              are mine, with the same treatment your business gets.
            </p>
            {%- endif %}
          </div>
          {% include "components/pricing-tiers.njk" %}

          {%- if p.extra %}
          <p class="svc-extra reveal">
            <span class="svc-extra-p">{{ p.extra.price | money | safe }}</span>
            <span>
              <b>{{ p.extra.label }}</b><br />
              {{ p.extra.note }}
            </span>
          </p>
          {%- endif %}

          {%- elif p.kind == "package" %}
          <div class="sec-head reveal" style="margin-bottom: 20px;">
            <h2 class="svc-h2">Priced as a package.</h2>
          </div>
          <div class="aside-card reveal">
            <span class="aside-price">From {{ packages.tiers[0].price | price | safe }}</span>
            <p class="aside-note">
              A one-time price agreed before I start, plus a care plan from
              {{ careplans.plans[0].price | price | safe }} a month for hosting, security and edits.
            </p>
            <a class="btn btn-ghost" href="/packages/">Compare the three packages</a>
          </div>

          {%- elif p.kind == "care" %}
          <div class="sec-head reveal" style="margin-bottom: 20px;">
            <h2 class="svc-h2">Two plans. Pick one.</h2>
          </div>
          {% include "components/care-cards.njk" %}

          {%- elif p.kind == "flat" %}
          <div class="sec-head reveal" style="margin-bottom: 20px;">
            <h2 class="svc-h2">{{ p.heading or "One price, one time." }}</h2>
          </div>
          <div class="aside-card reveal">
            <span class="aside-price">{% if p.from %}<span class="money-pre">From</span> {% endif %}{{ p.price | price | safe }}</span>
            {%- if p.unit %}<span class="aside-unit">{{ p.unit }}</span>{% endif %}
            <p class="aside-note">{{ p.note }}</p>
            {%- if p.extras %}
            <ul class="aside-extras">
              {%- for x in p.extras %}
              <li><span>{{ x.label }}</span><b>+{{ x.price | price | safe }}</b></li>
              {%- endfor %}
            </ul>
            {%- endif %}
            <a class="btn btn-ghost" href="/pricing/">See the full price list</a>
          </div>

          {%- elif p.kind == "soon" %}
          <div class="sec-head reveal" style="margin-bottom: 20px;">
            <h2 class="svc-h2">Not open for orders yet.</h2>
          </div>
          <div class="aside-card reveal">
            <span class="tag-soon">Coming soon</span>
            <p class="aside-note">
              The pricing is not settled, so there is no number here. I would rather
              say that than invent one and change it on you later.
            </p>
            <a class="btn btn-ghost" href="/contact/">Ask me where it stands</a>
          </div>
          {%- endif %}

          {%- if svc.packageNote and not tiers.length %}
          <p class="svc-pnote reveal">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-tag"/></svg>
            <span>{{ svc.packageNote | safe }}</span>
          </p>
          {%- endif %}

        </div>

        <!-- ──────── right: what it is ──────── -->
        <div class="svc-story">
          <div class="svc-prose reveal">
            {%- for para in svc.intro %}
            <p>{{ para }}</p>
            {%- endfor %}
          </div>

          <h2 class="svc-h2 reveal" style="margin-top: 36px;">What you get</h2>
          <ul class="inc-list reveal" style="--d:1">
            {%- for i in svc.includes %}
            <li>{{ i }}</li>
            {%- endfor %}
          </ul>

          <div class="svc-facts reveal" style="--d:1">
            {%- if svc.packageKey %}
            <div class="aside-card">
              <h3>In which packages</h3>
              <ul class="in-pack">
                {%- for t in packages.tiers %}
                {%- set v = t.has[svc.packageKey] %}
                <li>
                  {%- if v %}
                  <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
                  {%- else %}
                  <svg class="ic no" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-dash"/></svg>
                  {%- endif %}
                  <span>
                    <b>{{ t.name }}</b>
                    {%- if v and v !== true %} <em>({{ v }})</em>
                    {%- elif not v %} <em>(add it on its own)</em>{% endif %}
                  </span>
                </li>
                {%- endfor %}
              </ul>
            </div>
            {%- endif %}

            {%- if svc.callout %}
            <div class="aside-card">
              <h3>{{ svc.callout.title }}</h3>
              <p class="aside-note" style="margin-top: 0;">{{ svc.callout.body }}</p>
            </div>
            {%- endif %}

            <div class="aside-card">
              <h3>Turnaround</h3>
              <p class="aside-note" style="margin-top: 0;">
                {%- if svc.turnaroundNote %}
                {{ svc.turnaroundNote | safe }}
                {%- else %}
                A standard build takes <b style="color:var(--text)">{{ site.turnaround }}</b>
                from the day your content arrives. Need it sooner? Rush delivery is a
                listed <a href="/pricing/#project-extras" style="color: var(--blue);">flat fee</a>,
                not a renegotiation.
                {%- endif %}
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  {%- if not svc.noProcess %}
  {%- set processHeading = svc.processHeading or ("How " + svc.name | lower + " gets built.") %}
  {% include "components/process-steps.njk" %}
  {%- endif %}


  <!-- ══════════════ FAQ ══════════════ -->
  {%- if svc.faq %}
  <section class="sec band sec-line">
    <div class="wrap wrap-mid">
      <div class="sec-head reveal" style="margin-bottom: 30px;">
        <h2>Questions</h2>
      </div>
      <div class="faq reveal">
        {%- for item in svc.faq %}
        <details>
          <summary>{{ item.q }}</summary>
          <div class="faq-a">{{ item.a }}</div>
        </details>
        {%- endfor %}
      </div>
    </div>
  </section>
  {%- endif %}


  <!-- ══════════════ RELATED ══════════════ -->
  {%- set rel = svc.related | resolve(services) %}
  {%- if rel.length %}
  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal" style="margin-bottom: 26px;">
        <h2 style="font-size: clamp(22px, 2.4vw, 28px);">Often bought with this</h2>
      </div>
      <div class="related-grid">
        {%- for card in rel %}
        {%- set d = loop.index0 %}
        {% include "components/service-card.njk" %}
        {%- endfor %}
      </div>
    </div>
  </section>
  {%- endif %}


  {% include "components/cta-band.njk" %}

</main>

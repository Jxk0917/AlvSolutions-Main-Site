---
layout: layouts/base.njk
pagination:
  data: services
  size: 1
  alias: svc
permalink: "/services/{{ svc.slug }}/"
eleventyComputed:
  title: "{{ svc.name }}"
  description: "{{ svc.promise }}"
---

{%- set famLabel = { web: "Websites", ads: "Advertising", print: "Print & apparel" } -%}
{%- set fam = famLabel[svc.family] -%}
{%- set a = addons | find("slug", svc.addon) -%}
{%- set group = addons | byService(svc.addonGroup) if svc.addonGroup else [] -%}

{#- ─────────── normalise pricing into one `tiers` shape ───────────
    Two different data shapes land on this page: one add-on carrying several
    levels (a menu page priced simple or complex), or several add-ons carrying
    one level each (the basic and premium cards). The picker should not have
    to care, so the difference is flattened here.

    `push` inside a loop is the codebase's existing trick for building an
    array in Nunjucks — the `set` is a no-op, the mutation is what persists. -#}
{%- set tiers = [] -%}
{%- set hasFactors = false -%}
{%- set cmpFactors = [] -%}
{%- set cmpName = "" -%}

{%- if a -%}
  {%- set hasFactors = true if a.factors else false -%}
  {%- set cmpFactors = a.factors or [] -%}
  {%- set cmpName = a.name -%}
  {%- for l in a.levels -%}
    {%- set li = loop.index0 -%}
    {%- set rows = [] -%}
    {%- for f in (a.factors or []) -%}
      {%- set rows = (rows.push({ label: f.label, value: f.values[li], example: f.example }), rows) -%}
    {%- endfor -%}
    {%- set tiers = (tiers.push({ label: l.label, price: l.price, unit: l.unit, rows: rows }), tiers) -%}
  {%- endfor -%}
{%- elif group.length -%}
  {#- Several add-ons, one level each. The factors that tell them apart cannot
      live on any single add-on — they compare across the pair — so the service
      carries them and the values are indexed by tier order. -#}
  {%- set gf = svc.factors or [] -%}
  {%- set hasFactors = true if gf.length else false -%}
  {%- set cmpFactors = gf -%}
  {%- set cmpName = svc.name | lower -%}
  {%- for g in group -%}
    {%- set gi = loop.index0 -%}
    {%- set rows = [] -%}
    {%- for f in gf -%}
      {%- set rows = (rows.push({ label: f.label, value: f.values[gi], example: f.example }), rows) -%}
    {%- endfor -%}
    {%- set tiers = (tiers.push({ label: g.levels[0].label, price: g.levels[0].price,
                                  note: g.blurb, shot: g.shot, rows: rows }), tiers) -%}
  {%- endfor -%}
{%- endif -%}
{%- set ptid = svc.slug -%}
{#- a plain `set` inside a for loop stays in the loop's scope; mutating an
    array is what survives, so the flag is counted rather than assigned. -#}
{%- set shotFlags = [] -%}
{%- for t in tiers -%}{% if t.shot %}{% set shotFlags = (shotFlags.push(1), shotFlags) %}{% endif %}{%- endfor -%}
{%- set hasShots = shotFlags.length > 0 -%}

{%- set ph = {
  eyebrow: fam,
  heading: svc.name,
  lead: svc.promise,
  back: { label: "Services", url: "/services/" },
  crumbs: [{ label: "Services", url: "/services/" }, { label: svc.name }],
  actions: [
    { label: "Start a project", url: "/contact/" },
    { label: "See packages", url: "/packages/", style: "btn-ghost" }
  ]
} -%}
{% include "components/pagehead.njk" %}

<main id="main">

  {#- ══════════════ ONE SECTION: cost on the left, the case on the right ═════
      These used to be two stacked sections — pricing full-width, then the
      description below it — which read as two unrelated pages glued together.
      Side by side, the factor list answers "what will mine cost" while the
      prose beside it answers "what is it", and neither has to be scrolled
      past to reach the other.

      Left also carries the two fact cards (which packages, turnaround),
      because those are the same kind of commercial detail as the price. -#}
  <section class="sec">
    <div class="wrap">
      <div class="svc-split">

        <!-- ──────── left: what it costs ──────── -->
        <div class="svc-money">
          {%- if tiers.length %}
          <div class="sec-head reveal" style="margin-bottom: 20px;">
            <span class="eyebrow">Pricing</span>
            <h2 class="svc-h2" style="margin-top: 12px;">
              {%- if a and a.pricing == "monthly" %}Setup once, then month to month.
              {%- elif tiers.length > 2 %}Priced by how big the job is.
              {%- else %}Two levels, and the rule for each.{% endif %}
            </h2>
            {%- if hasShots %}
            <p class="body-3" style="margin-top: 12px;">
              Both designed against the same brand as your site. The cards below
              are mine &mdash; the same treatment your business gets.
            </p>
            {%- endif %}
          </div>
          {% include "components/pricing-tiers.njk" %}

          {%- elif svc.packagePricing or svc.included %}
          <div class="sec-head reveal" style="margin-bottom: 20px;">
            <span class="eyebrow">Pricing</span>
            <h2 class="svc-h2" style="margin-top: 12px;">
              {{ "Priced with the package." if svc.packagePricing else "No charge, ever." }}
            </h2>
          </div>
          <div class="aside-card reveal">
            {%- if svc.packagePricing %}
            <span class="aside-price">From {{ packages.tiers[0].price | price | safe }}</span>
            <p class="aside-note">Flat, agreed before I start. Three packages, each with a monthly plan for hosting and updates.</p>
            <a class="btn btn-ghost" href="/packages/">
              Compare packages
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
            </a>
            {%- else %}
            <span class="aside-price">Included</span>
            <p class="aside-note">In every package, at no extra cost. There is no separate SEO retainer and there never will be.</p>
            <a class="btn btn-ghost" href="/packages/">
              See packages
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
            </a>
            {%- endif %}
          </div>
          {%- endif %}

        </div>

        <!-- ──────── right: what it is ──────── -->
        <div class="svc-story">
          <div class="svc-prose reveal">
            {%- for p in svc.intro %}
            <p>{{ p }}</p>
            {%- endfor %}
          </div>

          <h2 class="svc-h2 reveal" style="margin-top: 36px;">What you get</h2>
          <ul class="inc-list reveal" style="--d:1">
            {%- for i in svc.includes %}
            <li>{{ i }}</li>
            {%- endfor %}
          </ul>

          <div class="svc-facts reveal" style="--d:1">
            {%- if svc.packageKey or svc.packagePricing or svc.included %}
            <div class="aside-card">
              <h3>In which packages</h3>
              <ul class="in-pack">
                {%- for t in packages.tiers %}
                {%- set v = true if (svc.packagePricing or svc.included) else t.has[svc.packageKey] %}
                <li>
                  {%- if v %}
                  <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
                  {%- else %}
                  <svg class="ic no" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-dash"/></svg>
                  {%- endif %}
                  <span>
                    <b>{{ t.name }}</b>
                    {%- if v === "either" %} &mdash; as your one choice
                    {%- elif v and v !== true %} &mdash; {{ v }}
                    {%- elif not v %} &mdash; add it à la carte{% endif %}
                  </span>
                </li>
                {%- endfor %}
              </ul>
            </div>
            {%- endif %}

            <div class="aside-card">
              <h3>Turnaround</h3>
              <p class="aside-note" style="margin-top: 0;">
                {%- if svc.turnaroundNote %}
                {{ svc.turnaroundNote | safe }}
                {%- else %}
                Standard build is <b style="color:var(--text)">{{ site.turnaround }}</b>.
                Need it sooner? Rush delivery is a listed
                <a href="/packages/#fees" style="color: var(--blue);">flat fee</a>, not a renegotiation.
                {%- endif %}
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  {#- The pricing detail that used to sit here is now the Compare tab at the
      top of the page, so the same table is not printed twice. -#}

  {%- set processHeading = svc.processHeading or ("How " + svc.name | lower + " gets built.") %}
  {% include "components/process-steps.njk" %}


  <!-- ══════════════ FAQ ══════════════ -->
  {%- if svc.faq %}
  <section class="sec band sec-line">
    <div class="wrap wrap-mid">
      <div class="sec-head reveal" style="margin-bottom: 30px;">
        <h2>Questions</h2>
      </div>
      <div class="faq reveal">
        {%- for item in svc.faq %}
        <details>
          <summary>{{ item.q }}</summary>
          <div class="faq-a">{{ item.a }}</div>
        </details>
        {%- endfor %}
      </div>
    </div>
  </section>
  {%- endif %}


  <!-- ══════════════ RELATED ══════════════ -->
  {%- set rel = svc.related | resolve(services) %}
  {%- if rel.length %}
  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal" style="margin-bottom: 26px;">
        <h2 style="font-size: clamp(22px, 2.4vw, 28px);">Often bought with this</h2>
      </div>
      <div class="related-grid">
        {%- for card in rel %}
        {%- set d = loop.index0 %}
        {% include "components/service-card.njk" %}
        {%- endfor %}
      </div>
    </div>
  </section>
  {%- endif %}


  {% include "components/cta-band.njk" %}

</main>
